# Copy to .env and replace placeholders with your environment's values.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=voice_manager
DB_PASSWORD=replace-with-your-database-password
DB_NAME=voice_rdm

AUTH_SECRET=replace-with-a-long-random-secret

# Nuxt private runtimeConfig.tos, configurable at runtime after build.
NUXT_TOS_ENDPOINT=tos-cn-guangzhou.volces.com
NUXT_TOS_REGION=cn-guangzhou
NUXT_TOS_BUCKET=your-bucket
NUXT_TOS_DOMAIN=https://your-bucket.tos-cn-guangzhou.volces.com
NUXT_TOS_ACCESS_KEY=
NUXT_TOS_ACCESS_SECRET=
